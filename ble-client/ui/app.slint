import { Button, ComboBox, VerticalBox, HorizontalBox } from "std-widgets.slint";
export struct Metric { label: string, value: string }

export component TelemetryWindow inherits Window {
    title: "EKD01 BLE Telemetry";
    preferred-width: 940px; preferred-height: 720px;
    min-width: 820px; min-height: 680px;
    background: #111923;
    default-font-size: 15px;
    in property <[string]> devices;
    in-out property <int> selected: -1;
    in property <[Metric]> metrics;
    in property <string> status: "Enable Bluetooth on the display, then scan.";
    in property <string> details: "Read-only telemetry · Missing and stale values are shown as —";
    in property <bool> scanning;
    in property <bool> connected;
    in property <bool> busy;
    callback scan();
    callback connect(int);
    VerticalBox {
        padding: 20px; spacing: 12px;
        HorizontalBox {
            height: 40px; spacing: 10px;
            ComboBox { model: root.devices; current-index <=> root.selected; enabled: !root.busy && !root.connected; horizontal-stretch: 1; }
            Button { text: root.scanning ? "Stop scan" : "Scan"; enabled: !root.busy; clicked => { root.scan(); } }
            Button { text: root.connected ? "Disconnect" : "Connect"; enabled: !root.busy && (root.connected || root.selected >= 0); clicked => { root.connect(root.selected); } }
        }
        Text { height: 28px; text: root.status; color: white; overflow: elide; vertical-alignment: center; }
        Rectangle {
            horizontal-stretch: 1; vertical-stretch: 1;
            background: transparent;
            for metric[index] in root.metrics: Rectangle {
                x: mod(index, 3) * (parent.width + 12px) / 3;
                y: floor(index / 3) * (parent.height + 12px) / 5;
                width: (parent.width - 24px) / 3;
                height: (parent.height - 48px) / 5;
                border-radius: 8px;
                background: #1d2c3c;
                Text { x: 14px; y: 10px; width: parent.width - 28px; height: 22px; text: metric.label; color: #c4d3e0; font-size: 14px; overflow: elide; }
                Text { x: 14px; y: 36px; width: parent.width - 28px; height: parent.height - 46px; text: metric.value; color: index < 3 ? #75e5da : white; font-size: index < 3 ? 30px : 23px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            }
        }
        Text { height: 24px; text: root.details; color: #c4d3e0; font-size: 13px; overflow: elide; vertical-alignment: center; }
    }
}
