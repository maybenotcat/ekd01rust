import { UiText } from "text.slint";
import { StatisticKind } from "types.slint";
import "../assets/Oxanium-Medium.ttf";

export component ClassicDashboard inherits Rectangle {
    // Standalone editor preview values. app.slint binds every input below to
    // application state, overriding these defaults in the firmware.
    width: 320px;
    height: 240px;
    in property <int> speed-tenths: 253;
    in property <bool> speed-available: true;
    in property <int> speed-fill: 34;
    in property <int> power-fill: 37;
    in property <string> speed-unit: "km/h";
    in property <string> speed-max: "75";
    in property <string> speed-mid: "50";
    in property <string> power: "742 W";
    in property <int> battery: 78;
    in property <string> battery-text: "78%";
    in property <string> voltage: "52.7 V";
    in property <int> assist: 5;
    in property <string> trip: "12.34 km";
    in property <string> odometer: "321.0 km";
    in property <bool> lights: true;
    in property <int> bluetooth: 3;
    in property <string> error;
    in property <bool> fault;
    in property <string> status;
    in property <bool> status-error;
    private property <bool> three-digits: root.speed-tenths >= 1000 && root.speed-available;
    private property <length> speed-main-font: root.three-digits ? 76px : 104px;
    private property <length> speed-main-width: root.speed-main-font * 0.578 * (root.three-digits ? 3 : 2);
    private property <length> speed-group-x: 138px - (root.speed-main-width + 49px) / 2;
    private property <length> speed-center-y: 101.5px;
    private property <length> speed-top: root.speed-center-y - root.speed-main-font * 0.345;
    private property <length> speed-baseline: root.speed-center-y + root.speed-main-font * 0.345;
    background: #050607;

    // The scale endpoints match the presenter: 75 km/h and 2000 W.
    Text { x: 64px; y: 6px; width: 57px; height: 19px; text: root.speed-max; color: white; font-size: 18px; horizontal-alignment: center; }
    Text { x: 106px; y: 10px; text: root.speed-unit; color: white; font-size: 12px; }
    Text { x: 159px; y: 6px; width: 72px; height: 19px; text: "2000" + @tr(" W"); color: white; font-size: 18px; }
    if root.lights: Image { x: 10px; y: 7px; width: 28px; height: 22px; source: @image-url("../assets/classic/light.svg"); }
    if root.bluetooth != 0: Image { x: 248px; y: 5px; width: 15px; height: 22px; source: @image-url("../assets/bluetooth.svg"); colorize: root.bluetooth == 3 ? #57b894 : root.bluetooth == 2 ? #45d0e8 : #f4a34d; }

    Image { x: 35px; y: 30px; width: 105px; height: 143px; source: @image-url("../assets/classic/left-scale.svg"); }
    Rectangle { x: 35px; y: 30px + 143px * (100 - root.speed-fill) / 100; width: 105px; height: 143px * root.speed-fill / 100; clip: true; background: transparent;
        Image { y: -143px * (100 - root.speed-fill) / 100; width: 105px; height: 143px; source: @image-url("../assets/classic/left-scale.svg"); colorize: #ff9e32; }
    }
    Image { x: 153px; y: 30px; width: 82px; height: 123px; source: @image-url("../assets/classic/right-scale.svg"); }
    Rectangle { x: 153px; y: 30px + 123px * (100 - root.power-fill) / 100; width: 82px; height: 123px * root.power-fill / 100; clip: true; background: transparent;
        Image { y: -123px * (100 - root.power-fill) / 100; width: 82px; height: 123px; source: @image-url("../assets/classic/right-scale.svg"); colorize: #69c9ed; }
    }
    Text { x: 0px; y: 69px; width: 32px; height: 20px; text: root.speed-mid; color: white; font-size: 18px; horizontal-alignment: right; }
    Text { x: 0px; y: 89px; width: 32px; text: root.speed-unit; color: white; font-size: 12px; horizontal-alignment: right; }
    Text { x: 236px; y: 74px; width: 38px; text: "1000"; color: white; font-size: 12px; }
    Text { x: 237px; y: 90px; text: @tr("W"); color: white; font-size: 12px; }
    Text { x: 124px; y: 160px; text: "0"; color: white; font-size: 14px; }
    // The power scale ends at x = 153 + 78 in right-scale.svg.
    Text { x: 221px; y: 153px; width: 20px; height: 20px; text: "0"; color: white; font-size: 14px; horizontal-alignment: center; }

    // Oxanium uses the same digit-only raster atlas policy as Standard. Align
    // the shared baseline using its own advances and ascent/descent metrics.
    // Leave enough line height for glyph tops; align the integer to the decimal.
    Text { x: root.speed-group-x; y: root.speed-baseline - 52px - root.speed-main-font * 0.29;
        width: root.speed-main-width; height: 104px;
        text: root.speed-available ? "\{floor(root.speed-tenths / 10)}" : "--";
        font-family: "Oxanium"; font-weight: 500; font-size: root.speed-main-font;
        color: white; horizontal-alignment: right; vertical-alignment: center;
    }
    Text { x: root.speed-group-x + root.speed-main-width; y: root.speed-baseline - 32px - 58px * 0.29;
        width: 49px; height: 64px;
        text: root.speed-available ? ".\{mod(root.speed-tenths, 10)}" : ".-";
        font-family: "Oxanium"; font-weight: 500; font-size: 58px;
        color: white; vertical-alignment: center;
    }
    Text { x: 155px; y: root.speed-top - 4px; width: 64px; text: root.speed-unit; color: white; font-size: 14px; horizontal-alignment: right; }
    Text { x: 155px; y: 163px; width: 68px; height: 24px; text: root.power; color: white; font-size: 20px; horizontal-alignment: center; }

    Text { x: 267px; y: 30px; width: 51px; text: root.battery-text; color: white; font-size: 18px; horizontal-alignment: center; }
    Rectangle { x: 285px; y: 57px; width: 14px; height: 5px; background: white; border-radius: 2px; }
    Rectangle { x: 273px; y: 61px; width: 38px; height: 127px; background: #050607; border-width: 2px; border-color: white; border-radius: 6px;
        Rectangle { x: 5px; y: 5px; width: 28px; height: 117px; background: #17212a;
            Rectangle { y: parent.height - self.height; width: parent.width; height: parent.height * root.battery / 100;
                background: @linear-gradient(0deg, #ef453d 0%, #e4c745 35%, #77c552 62%, #3e8de0 100%);
            }
        }
    }

    Text { x: 8px; y: 194px; width: 98px; height: 18px; text: UiText.caption(StatisticKind.trip); color: #ff6255; font-size: 14px; horizontal-alignment: center; }
    Text { x: 158px; y: 194px; width: 89px; height: 18px; text: UiText.odometer-caption(); color: #ff6255; font-size: 14px; horizontal-alignment: center; }
    Rectangle { x: 5px; y: 212px; width: 103px; height: 2px; background: white; }
    Rectangle { x: 154px; y: 212px; width: 91px; height: 2px; background: white; }
    Rectangle { x: 252px; y: 212px; width: 65px; height: 2px; background: white; }
    Text { x: 5px; y: 216px; width: 103px; height: 22px; text: root.trip; color: white; font-size: 18px; horizontal-alignment: center; }
    Text { x: 154px; y: 216px; width: 91px; height: 22px; text: root.odometer; color: white; font-size: 18px; horizontal-alignment: center; }
    Text { x: 251px; y: 216px; width: 67px; height: 22px; text: root.voltage; color: white; font-size: 18px; horizontal-alignment: center; }
    Rectangle { x: 107px; y: 190px; width: 48px; height: 48px; background: #050607; border-radius: 24px; border-width: 2px; border-color: white;
        Text { width: parent.width; height: parent.height; text: root.assist; color: white; font-size: 28px; horizontal-alignment: center; vertical-alignment: center; }
    }
    // Errors consume space only while present and remain visible in either theme.
    if root.error != "" || root.status != "": Rectangle {
        x: 53px; y: 29px; width: 179px; height: 22px; background: #050607;
        Text { width: parent.width; height: parent.height; text: root.status != "" ? root.status : root.error; color: root.fault || root.status-error ? #ff6868 : #ffbd55; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    }
}
