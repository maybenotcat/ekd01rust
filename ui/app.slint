import { ClassicDashboard } from "classic.slint";
import { StandardDashboard } from "standard.slint";
import { SettingsPage } from "settings.slint";
import { RidePage } from "ride.slint";
import { InformationPage } from "information.slint";
import { UiText } from "text.slint";
export { UiText } from "text.slint";
export { MenuText } from "menu-labels.slint";
import { Screen, MenuItem, MenuPage, MenuEntry, Statistic, StatusCode, ValueKind, StatisticKind, DashboardData, InformationData, DiagnosticsData } from "types.slint";
export { Screen, MenuItem, MenuPage, MenuEntry, Statistic, StatusCode, ValueKind, DisplayValue, CounterValue, StatisticKind, DashboardData, InformationData, DiagnosticsData } from "types.slint";
import "../assets/NotoSans-Regular.ttf";
import "../assets/EKD01Speed.ttf";

export component Dashboard inherits Window {
    width: 320px;
    height: 240px;
    background: #0b1220;
    default-font-family: "Noto Sans";
    in property <Screen> view: Screen.dashboard;
    in property <int> theme: 0;
    in property <bool> russian;
    in property <bool> imperial;
    // Standalone preview data; the presenter supplies live numeric values.
    in property <DashboardData> dashboard-data: {
        speed-tenths: 253, speed-available: true, classic-speed-fill: 34,
        power: { kind: ValueKind.power, whole: 742, fraction: 0, available: true, flag: false },
        voltage: { kind: ValueKind.voltage, whole: 52, fraction: 7, available: true, flag: false },
        battery: { kind: ValueKind.percent, whole: 78, fraction: 0, available: true, flag: false },
        trip: { kind: ValueKind.distance-hundredths, whole: 12, fraction: 34, available: true, flag: false },
        odometer: { kind: ValueKind.distance-tenths, whole: 321, fraction: 0, available: true, flag: false },
        assist: 5, lights: true, bluetooth: 3, fault: false, error-code: 0, service-due: false,
    };
    in property <[Statistic]> statistics;
    in property <[MenuEntry]> menu-items;
    in property <MenuPage> menu-page: MenuPage.root;
    in property <int> menu-selected;
    in property <MenuItem> information-item: MenuItem.battery-info;
    in property <InformationData> information-data;
    in property <DiagnosticsData> diagnostics-data;
    in property <StatusCode> status-code: StatusCode.none;
    in property <bool> status-error;

    private property <string> status: root.status-code == StatusCode.page-position ? "\{root.menu-selected + 1} / \{root.menu-items.length}" : UiText.status(root.status-code, root.russian);
    private property <string> error: UiText.dashboard-error(root.dashboard-data.fault, root.dashboard-data.error-code, root.dashboard-data.service-due, root.russian);
    private property <string> speed-integer: root.dashboard-data.speed-available ? "\{floor(root.dashboard-data.speed-tenths / 10)}" : "--";
    private property <string> speed-fraction: root.dashboard-data.speed-available ? ".\{mod(root.dashboard-data.speed-tenths, 10)}" : ".-";
    private property <string> speed-unit: UiText.speed-unit(root.russian, root.imperial);
    private property <string> power: UiText.value(root.dashboard-data.power, root.russian, root.imperial);
    private property <int> power-fill: root.dashboard-data.power.available ? min(floor(max(root.dashboard-data.power.whole, 0) / 20), 100) : 0;
    private property <string> voltage: UiText.value(root.dashboard-data.voltage, root.russian, root.imperial);
    private property <string> battery-text: UiText.value(root.dashboard-data.battery, root.russian, root.imperial);
    private property <int> battery: root.dashboard-data.battery.available ? root.dashboard-data.battery.whole : 0;
    private property <string> trip: UiText.value(root.dashboard-data.trip, root.russian, root.imperial);
    private property <string> odometer: UiText.value(root.dashboard-data.odometer, root.russian, root.imperial);

    if root.view == Screen.dashboard && root.theme == 0: StandardDashboard {
        width: 320px; height: 240px;
        speed-integer: root.speed-integer; speed-fraction: root.speed-fraction;
        speed-digit-count: !root.dashboard-data.speed-available ? 2 : root.dashboard-data.speed-tenths >= 1000 ? 3 : root.dashboard-data.speed-tenths >= 100 ? 2 : 1;
        compact-speed: root.dashboard-data.speed-available && root.dashboard-data.speed-tenths >= 1000;
        speed-unit: root.speed-unit; power: root.power; power-fill: root.power-fill;
        voltage: root.voltage; battery: root.battery; battery-text: root.battery-text;
        assist-level: root.dashboard-data.assist; trip-text: root.trip; trip-caption: UiText.caption(StatisticKind.trip, root.russian);
        odometer-text: root.odometer; lights: root.dashboard-data.lights; bluetooth: root.dashboard-data.bluetooth;
        russian: root.russian;
        status: root.status; status-error: root.status-error; error: root.error; fault: root.dashboard-data.fault;
    }
    if root.view == Screen.dashboard && root.theme == 1: ClassicDashboard {
        width: 320px; height: 240px;
        speed-tenths: root.dashboard-data.speed-tenths; speed-available: root.dashboard-data.speed-available;
        speed-fill: root.dashboard-data.classic-speed-fill;
        power-fill: root.power-fill;
        speed-unit: root.speed-unit; speed-max: root.imperial ? "47" : "75"; speed-mid: root.imperial ? "31" : "50";
        power: root.power; battery: root.battery; battery-text: root.battery-text;
        voltage: root.voltage; assist: root.dashboard-data.assist; trip: root.trip; odometer: root.odometer;
        lights: root.dashboard-data.lights; bluetooth: root.dashboard-data.bluetooth; error: root.error; fault: root.dashboard-data.fault;
        russian: root.russian;
        status: root.status; status-error: root.status-error;
    }
    if root.view == Screen.menu: SettingsPage {
        page: root.menu-page; items: root.menu-items; selected: root.menu-selected;
        russian: root.russian; imperial: root.imperial;
        status: root.status; status-error: root.status-error;
    }
    if root.view == Screen.ride: RidePage {
        statistics: root.statistics; russian: root.russian; imperial: root.imperial;
        status: root.status; status-error: root.status-error;
    }
    if root.view == Screen.information || root.view == Screen.diagnostics: InformationPage {
        item: root.information-item; data: root.information-data;
        diagnostics: root.diagnostics-data; show-diagnostics: root.view == Screen.diagnostics;
        russian: root.russian; status: root.status; status-error: root.status-error;
    }
}
