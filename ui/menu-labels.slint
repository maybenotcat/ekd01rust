import { MenuItem, MenuPage } from "types.slint";

export global MenuText {
    // Group labels by settings domain instead of one deeply nested chain.
    public pure function label(item: MenuItem) -> string {
        if (item == MenuItem.flip-screen) { return @tr("Screen rotation"); }
        if (item == MenuItem.about) { return @tr("About"); }
        if (
            item == MenuItem.display ||
            item == MenuItem.motor ||
            item == MenuItem.information ||
            item == MenuItem.factory-reset ||
            item == MenuItem.exit ||
            item == MenuItem.back ||
            item == MenuItem.bluetooth
        ) {
            return root.navigation-label(item);
        }
        if (
            item == MenuItem.brightness ||
            item == MenuItem.units ||
            item == MenuItem.auto-off ||
            item == MenuItem.trip ||
            item == MenuItem.hour ||
            item == MenuItem.minute ||
            item == MenuItem.language ||
            item == MenuItem.theme ||
            item == MenuItem.service ||
            item == MenuItem.sensitivity
        ) {
            return root.display-label(item);
        }
        if (
            item == MenuItem.levels ||
            item == MenuItem.limit ||
            item == MenuItem.wheel ||
            item == MenuItem.circumference ||
            item == MenuItem.advanced
        ) {
            return root.motor-label(item);
        }
        if (
            item == MenuItem.battery-info ||
            item == MenuItem.ctrl-info ||
            item == MenuItem.display-info ||
            item == MenuItem.torque-info ||
            item == MenuItem.errors ||
            item == MenuItem.diagnostics ||
            item == MenuItem.error-clear
        ) {
            return root.information-label(item);
        }
        if (
            item == MenuItem.current ||
            item == MenuItem.speed ||
            item == MenuItem.start ||
            item == MenuItem.power-mode
        ) {
            return root.advanced-label(item);
        }
        if (
            item == MenuItem.level1 ||
            item == MenuItem.level2 ||
            item == MenuItem.level3 ||
            item == MenuItem.level4 ||
            item == MenuItem.level5 ||
            item == MenuItem.level6 ||
            item == MenuItem.level7 ||
            item == MenuItem.level8 ||
            item == MenuItem.level9
        ) {
            return root.levels-label(item);
        }
        if (
            item == MenuItem.service-interval ||
            item == MenuItem.service-reset ||
            item == MenuItem.service-distance ||
            item == MenuItem.odometer
        ) {
            return root.service-label(item);
        }
        return "";
    }

    pure function navigation-label(item: MenuItem) -> string {
        if (item == MenuItem.display) { return @tr("Display Setting"); }
        if (item == MenuItem.motor) { return @tr("Motor Settings"); }
        if (item == MenuItem.information) { return @tr("Information"); }
        if (item == MenuItem.factory-reset) { return @tr("Factory Reset"); }
        if (item == MenuItem.exit) { return @tr("Exit"); }
        if (item == MenuItem.back) { return @tr("Back"); }
        if (item == MenuItem.bluetooth) { return @tr("Bluetooth"); }
        return "";
    }

    pure function display-label(item: MenuItem) -> string {
        if (item == MenuItem.brightness) { return @tr("Brightness"); }
        if (item == MenuItem.units) { return @tr("Unit"); }
        if (item == MenuItem.auto-off) { return @tr("Auto Power Off"); }
        if (item == MenuItem.trip) { return @tr("TRIP Reset"); }
        if (item == MenuItem.hour) { return @tr("Clock / hour"); }
        if (item == MenuItem.minute) { return @tr("Clock / minute"); }
        if (item == MenuItem.language) { return @tr("Language"); }
        if (item == MenuItem.theme) { return @tr("Home screen"); }
        if (item == MenuItem.service) { return @tr("Service"); }
        if (item == MenuItem.sensitivity) { return @tr("Light sensitivity"); }
        return "";
    }

    pure function motor-label(item: MenuItem) -> string {
        if (item == MenuItem.levels) { return @tr("Boost Gear"); }
        if (item == MenuItem.limit) { return @tr("Speed Limit"); }
        if (item == MenuItem.wheel) { return @tr("Wheel Size"); }
        if (item == MenuItem.circumference) { return @tr("Wheel Length"); }
        if (item == MenuItem.advanced) { return @tr("Advanced"); }
        return "";
    }

    pure function information-label(item: MenuItem) -> string {
        if (item == MenuItem.battery-info) { return @tr("Battery Info"); }
        if (item == MenuItem.ctrl-info) { return @tr("Ctrl Info"); }
        if (item == MenuItem.display-info) { return @tr("Display Info"); }
        if (item == MenuItem.torque-info) { return @tr("Torque Info"); }
        if (item == MenuItem.errors) { return @tr("Error code"); }
        if (item == MenuItem.diagnostics) { return @tr("Diagnostics"); }
        if (item == MenuItem.error-clear) { return @tr("Clear errors"); }
        return "";
    }

    pure function advanced-label(item: MenuItem) -> string {
        if (item == MenuItem.current) { return @tr("Current limits"); }
        if (item == MenuItem.speed) { return @tr("Speed limits"); }
        if (item == MenuItem.start) { return @tr("Start response"); }
        if (item == MenuItem.power-mode) { return @tr("Power mode"); }
        return "";
    }

    pure function levels-label(item: MenuItem) -> string {
        if (item == MenuItem.level1) { return @tr("Level 1"); }
        if (item == MenuItem.level2) { return @tr("Level 2"); }
        if (item == MenuItem.level3) { return @tr("Level 3"); }
        if (item == MenuItem.level4) { return @tr("Level 4"); }
        if (item == MenuItem.level5) { return @tr("Level 5"); }
        if (item == MenuItem.level6) { return @tr("Level 6"); }
        if (item == MenuItem.level7) { return @tr("Level 7"); }
        if (item == MenuItem.level8) { return @tr("Level 8"); }
        if (item == MenuItem.level9) { return @tr("Level 9"); }
        return "";
    }

    pure function service-label(item: MenuItem) -> string {
        if (item == MenuItem.service-interval) { return @tr("Service interval"); }
        if (item == MenuItem.service-reset) { return @tr("Service reset"); }
        if (item == MenuItem.service-distance) { return @tr("Since service"); }
        if (item == MenuItem.odometer) { return @tr("Odometer"); }
        return "";
    }

    public pure function title(page: MenuPage) -> string {
        if (page == MenuPage.root) { return @tr("SETTINGS"); }
        if (page == MenuPage.display) { return @tr("DISPLAY SETTING"); }
        if (page == MenuPage.motor) { return @tr("MOTOR SETTINGS"); }
        if (page == MenuPage.information) { return @tr("INFORMATION"); }
        if (page == MenuPage.advanced) { return @tr("ADVANCED MOTOR"); }
        if (page == MenuPage.current) { return @tr("CURRENT PER LEVEL"); }
        if (page == MenuPage.speed) { return @tr("SPEED PER LEVEL"); }
        if (page == MenuPage.start) { return @tr("START RESPONSE"); }
        if (page == MenuPage.service) { return @tr("SERVICE"); }
        return "";
    }
}
