import { StatusCode, ValueKind, DisplayValue, CounterValue, StatisticKind, MenuItem, InformationData, DiagnosticsData } from "types.slint";
import { MenuText } from "menu-labels.slint";

// All user-facing formatting and localization lives in Slint, not the presenter.
export global UiText {
    public pure function two(value: int) -> string {
        return value < 10 ? "0\{value}" : "\{value}";
    }
    public pure function counter(value: CounterValue) -> string {
        if (value.upper == 0) { return "\{value.lower}"; }
        return "\{value.upper}" + (value.lower < 10 ? "000" : value.lower < 100 ? "00" : value.lower < 1000 ? "0" : "") + "\{value.lower}";
    }
    pure function hex-digit(value: int) -> string {
        if (value < 10) { return "\{value}"; }
        return value == 10 ? "A" : value == 11 ? "B" : value == 12 ? "C" : value == 13 ? "D" : value == 14 ? "E" : "F";
    }
    public pure function hex2(value: int) -> string {
        return root.hex-digit(floor(mod(value, 256) / 16)) + root.hex-digit(mod(value, 16));
    }
    pure function hex4(value: int) -> string {
        return root.hex2(floor(value / 256)) + root.hex2(mod(value, 256));
    }
    public pure function hex6(value: int) -> string {
        return root.hex2(floor(value / 65536)) + root.hex4(mod(value, 65536));
    }
    public pure function distance-unit(imperial: bool) -> string {
        return imperial ? @tr("mi") : @tr("km");
    }
    public pure function speed-unit(imperial: bool) -> string {
        return imperial ? @tr("mph") : @tr("km/h");
    }
    public pure function caption(kind: StatisticKind) -> string {
        if (kind == StatisticKind.trip) { return @tr("TRIP"); }
        if (kind == StatisticKind.range) { return @tr("RANGE"); }
        if (kind == StatisticKind.cadence) { return @tr("CADENCE"); }
        if (kind == StatisticKind.battery) { return @tr("BATTERY"); }
        if (kind == StatisticKind.motor) { return @tr("MOTOR"); }
        return @tr("CONTROLLER");
    }
    public pure function odometer-caption() -> string {
        return @tr("ODO");
    }
    public pure function ride-title() -> string {
        return @tr("RIDE STATISTICS");
    }

    public pure function value(data: DisplayValue, imperial: bool) -> string {
        if (data.kind == ValueKind.empty) { return ""; }
        if (data.kind == ValueKind.navigation) { return ">"; }
        if (data.kind == ValueKind.unavailable) { return "--"; }
        if (data.kind == ValueKind.number) { return data.available ? "\{data.whole}" : "--"; }
        if (data.kind == ValueKind.distance-tenths || data.kind == ValueKind.distance-hundredths || data.kind == ValueKind.voltage || data.kind == ValueKind.metric-speed || data.kind == ValueKind.wheel) {
            return root.decimal-value(data, imperial);
        }
        if (data.kind == ValueKind.percent || data.kind == ValueKind.power || data.kind == ValueKind.millimetres || data.kind == ValueKind.kilometres || data.kind == ValueKind.cadence || data.kind == ValueKind.temperature || data.kind == ValueKind.start-response) {
            return root.measurement-value(data);
        }
        return root.option-value(data, imperial);
    }
    pure function decimal-value(data: DisplayValue, imperial: bool) -> string {
        if (data.kind == ValueKind.voltage) {
            return (data.available ? "\{data.whole}.\{data.fraction}" : "--.-") + " " + @tr("V");
        }
        if (data.kind == ValueKind.metric-speed) {
            return (data.available ? "\{data.whole}.\{data.fraction}" : "--") + " " + root.speed-unit(false);
        }
        if (data.kind == ValueKind.wheel) {
            return (data.available ? "\{data.whole}.\{data.fraction}" : "--") + " " + @tr("in");
        }
        return "\{data.whole}." + (data.kind == ValueKind.distance-hundredths ? root.two(data.fraction) : "\{data.fraction}") + " " + root.distance-unit(imperial);
    }
    pure function measurement-value(data: DisplayValue) -> string {
        if (data.kind == ValueKind.percent) { return data.available ? "\{data.whole}%" : "--%"; }
        if (data.kind == ValueKind.power) { return (data.available ? "\{data.whole}" : "--") + @tr(" W"); }
        if (data.kind == ValueKind.millimetres) { return (data.available ? "\{data.whole}" : "--") + " " + @tr("mm"); }
        if (data.kind == ValueKind.kilometres) { return "\{data.whole} " + root.distance-unit(false); }
        if (data.kind == ValueKind.cadence) { return (data.available ? "\{data.whole}" : "--") + @tr(" rpm"); }
        if (data.kind == ValueKind.temperature) { return (data.available ? "\{data.whole}" : "--") + " C"; }
        return "\{data.whole} / 8";
    }
    pure function option-value(data: DisplayValue, imperial: bool) -> string {
        if (data.kind == ValueKind.rotation) { return data.flag ? "180°" : "0°"; }
        if (data.kind == ValueKind.toggle) { return data.flag ? @tr("On") : @tr("Off"); }
        if (data.kind == ValueKind.confirmation) { return data.flag ? @tr("Yes") : @tr("No"); }
        if (data.kind == ValueKind.theme) { return data.flag ? @tr("Classic") : @tr("Standard"); }
        if (data.kind == ValueKind.distance-unit) { return root.distance-unit(imperial); }
        if (data.kind == ValueKind.clock) { return data.available ? root.two(data.whole) + ":" + root.two(data.fraction) : "--:--"; }
        if (data.kind == ValueKind.levels) { return "\{data.whole}" + @tr(" levels"); }
        if (data.kind == ValueKind.mode) { return @tr("Mode ") + "\{data.whole}"; }
        return data.whole == 0 ? @tr("Off") : "\{data.whole}" + @tr(" min");
    }

    public pure function status(code: StatusCode) -> string {
        if (code == StatusCode.none || code == StatusCode.page-position) { return ""; }
        if (code == StatusCode.apply || code == StatusCode.busy || code == StatusCode.offline || code == StatusCode.neutral || code == StatusCode.invalid || code == StatusCode.queued || code == StatusCode.sent || code == StatusCode.readback-ok) {
            return root.request-status(code);
        }
        if (code == StatusCode.reading || code == StatusCode.loaded || code == StatusCode.timeout || code == StatusCode.read-first || code == StatusCode.modified || code == StatusCode.writing || code == StatusCode.verifying || code == StatusCode.verified || code == StatusCode.bad-block || code == StatusCode.mismatch) {
            return root.transfer-status(code);
        }
        return root.system-status(code);
    }
    pure function request-status(code: StatusCode) -> string {
        if (code == StatusCode.apply) { return @tr("Apply"); }
        if (code == StatusCode.busy) { return @tr("Busy"); }
        if (code == StatusCode.offline) { return @tr("CAN offline"); }
        if (code == StatusCode.neutral) { return @tr("Set assist 0"); }
        if (code == StatusCode.invalid) { return @tr("Set values"); }
        if (code == StatusCode.queued) { return @tr("Queued"); }
        if (code == StatusCode.sent) { return @tr("Sent"); }
        return @tr("Readback OK");
    }
    pure function transfer-status(code: StatusCode) -> string {
        if (code == StatusCode.reading) { return @tr("Reading"); }
        if (code == StatusCode.loaded) { return @tr("Loaded"); }
        if (code == StatusCode.timeout) { return @tr("No reply"); }
        if (code == StatusCode.read-first) { return @tr("Read first"); }
        if (code == StatusCode.modified) { return @tr("Modified"); }
        if (code == StatusCode.writing) { return @tr("Writing"); }
        if (code == StatusCode.verifying) { return @tr("Verifying"); }
        if (code == StatusCode.verified) { return @tr("Verified"); }
        if (code == StatusCode.bad-block) { return @tr("Bad block"); }
        return @tr("Mismatch");
    }
    pure function system-status(code: StatusCode) -> string {
        if (code == StatusCode.save-error) { return @tr("Save error"); }
        if (code == StatusCode.edit) { return @tr("EDIT"); }
        if (code == StatusCode.powering-off) { return @tr("Powering off"); }
        if (code == StatusCode.settings-save-failed) { return @tr("Settings save failed"); }
        if (code == StatusCode.power-control-error) { return @tr("Power control error"); }
        return @tr("SERVICE DUE");
    }
    public pure function dashboard-error(fault: bool, code: int, service-due: bool) -> string {
        if (fault) { return @tr("ERROR ") + root.hex2(code); }
        return service-due ? root.status(StatusCode.service-due) : "";
    }

    public pure function information(item: MenuItem, data: InformationData) -> string {
        if (item == MenuItem.battery-info) {
            return @tr("Total voltage") + "  " + root.value(data.voltage, false) + "\nSOC  " + root.value(data.battery, false);
        }
        if (item == MenuItem.ctrl-info) { return root.controller-information(data); }
        if (item == MenuItem.display-info) {
            return "LCD  320x240\nFLASH  " + root.hex6(data.flash-jedec) + " / 8 MiB\nPSRAM  8 MiB\nMCU  [" + root.hex2(data.mcu0) + ", " + root.hex2(data.mcu1) + ", " + root.hex2(data.mcu2) + ", " + root.hex2(data.mcu3) + ", " + root.hex2(data.mcu4) + "]\n" + root.two(data.hour) + ":" + root.two(data.minute);
        }
        if (item == MenuItem.torque-info) {
            return @tr("No torque sensor data\nSerial / version  --");
        }
        if (item == MenuItem.errors) { return root.error-information(data); }
        return @tr("Unavailable");
    }
    pure function controller-information(data: InformationData) -> string {
        if (!data.controller-available) { return @tr("Waiting for controller data"); }
        return MenuText.label(MenuItem.limit) + "  \{floor(data.limit / 100)}." + root.two(mod(data.limit, 100)) + " " + root.speed-unit(false) + "\n" +
            MenuText.label(MenuItem.wheel) + "  \{floor(data.wheel / 10)}.\{mod(data.wheel, 10)} " + @tr("in") + "\n" +
            MenuText.label(MenuItem.circumference) + "  \{data.circumference} " + @tr("mm") + "\nCAN RX  " + root.counter(data.can-rx) + "\n" +
            @tr("Serial / version") + "  --";
    }
    pure function error-information(data: InformationData) -> string {
        if (data.error-count == 0) { return @tr("No recorded errors"); }
        return @tr("Error ") + root.hex2(data.error-code) + "\n" +
            @tr("Source ") + "\{data.error-source} / cmd " + root.hex2(data.error-command) + ":\{data.error-subcommand}\n\{data.error-position} / \{data.error-count}";
    }
    public pure function diagnostics(data: DiagnosticsData) -> string {
        return "PSRAM  OK\nFLASH  " + (data.flash-writable ? "OK" : @tr("Read only")) + " / " + root.hex6(data.flash-jedec) +
            "\nCAN RX  " + root.counter(data.can-rx) + "  TX  " + root.counter(data.can-tx) +
            "\nMCU RX  " + root.counter(data.mcu-rx) + "\nADC  " + root.counter(data.adc-mv) + " mV / " +
            (data.adc-fresh ? @tr("fresh") : @tr("stale")) + "\n" +
            @tr("UART errors  ") + root.counter(data.uart-errors) + "\n" +
            @tr("Bad frames  ") + root.counter(data.bad-frames) + "\n" +
            @tr("Last CAN  ") + root.hex4(data.last-can-high) + root.hex4(data.last-can-low);
    }
}
